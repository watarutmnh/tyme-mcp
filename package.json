{
  "name": "tyme-mcp",
  "version": "0.2.0",
  "description": "MCP server for Tyme — control the macOS time tracking app through AI assistants",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "tyme-mcp": "src/index.ts"
  },
  "files": [
    "src/",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": "watarutmnh",
  "repository": {
    "type": "git",
    "url": "https://github.com/watarutmnh/tyme-mcp.git"
  },
  "keywords": [
    "mcp",
    "tyme",
    "time-tracking",
    "macos",
    "applescript",
    "jxa",
    "model-context-protocol"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/e2e-smoke.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^4.3.6"
  }
}
